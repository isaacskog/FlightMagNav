+function [coeff,weight] = robust_affine_fit(tau,delay)
+%ROBUST_AFFINE_FIT Fit offset and drift by bisquare weighted least squares.
+%
+% Start from ordinary least squares and update the weights using the
+% leverage-adjusted residuals. This replaces the robustfit call without
+% requiring the Statistics and Machine Learning Toolbox.
+
+    X = [ones(numel(tau),1),tau(:)];
+    y = delay(:);
+    [Q,R] = qr(X,0);
+    if rcond(R) < 1e-12
+        error('Cannot fit the clock model to these delay-estimation times.');
+    end
+    coeff = R\(Q.'*y);
+    weight = ones(size(y));
+
+    % With two or three points the robust scale is poorly determined.
+    if numel(y) <= 3
+        return
+    end
+
+    leverage = sum(Q.^2,2);
+    for iter = 1:50
+        weight = bisquare_weights(y - X*coeff,leverage,y);
+        sqrtWeight = sqrt(weight);
+        Xweighted = X.*sqrtWeight;
+        if rank(Xweighted) < 2
+            break
+        end
+
+        newCoeff = Xweighted\(sqrtWeight.*y);
+        if norm(newCoeff - coeff) <= 1e-9*max(1,norm(coeff))
+            coeff = newCoeff;
+            break
+        end
+        coeff = newCoeff;
+    end
+
+    weight = bisquare_weights(y - X*coeff,leverage,y);
+end
+
+
+function weight = bisquare_weights(residual,leverage,y)
+%BISQUARE_WEIGHTS Tukey weights with MAD scale and leverage correction.
+
+    absDeviation = sort(abs(residual - median(residual)));
+    scale = median(absDeviation(3:end))/0.6745;
+    scale = max(scale,sqrt(eps)*max(1,max(abs(y))));
+    scaledResidual = residual./(4.685*scale*sqrt(max(1-leverage,eps)));
+
+    weight = zeros(size(residual));
+    inlier = abs(scaledResidual) < 1;
+    weight(inlier) = (1 - scaledResidual(inlier).^2).^2;
+end
